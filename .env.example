# Copiar a .env (producción en el VPS) o .env.local (dev).
# Docker Compose toma estas variables automáticamente desde `.env`.
# Producción: NEXTAUTH_URL debe ser la URL pública (ej. https://sistema.mecnobile.com.ar).
# DATABASE_URL con localhost sirve para Prisma CLI; el compose sobrescribe el host a `db`.

# Zona horaria del taller. Imprescindible: sin esto el contenedor corre en UTC y
# los horarios de turnos enviados por WhatsApp salen corridos.
# Los días y horarios de atención NO van acá: se configuran en
# Dashboard → Configuración del taller.
TZ=America/Argentina/Buenos_Aires

# Postgres (también usadas por el servicio db del compose)
POSTGRES_USER=root
POSTGRES_PASSWORD=Root.1234
POSTGRES_DB=mecnobile-db

# Prisma CLI / local
DATABASE_URL="postgresql://root:Root.1234@localhost:5432/mecnobile-db?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET=
NEXTAUTH_SECRET=

# --- Meta WhatsApp Cloud API ---
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token

# Plantilla de utilidad al confirmar (Message templates → Utility).
# Name = turno_confirmado | Language = es_AR
# Body (variables en este orden exacto):
#   Hola {{1}}, tu turno en Nóbile quedó confirmado.
#   Fecha: {{2}}
#   Hora: {{3}}
#   Te esperamos en el taller. Si no podés asistir, avisanos por este medio.
# {{1}}=nombre  {{2}}=fecha  {{3}}=hora  → enviados por notifyAppointmentConfirmed
WHATSAPP_TEMPLATE_TURNO_CONFIRMADO=turno_confirmado

# Plantilla de utilidad para proponer entre 2 y 3 alternativas.
# Name = turno_alternativas | Language = es_AR
# Body:
#   Hola {{1}}, no podemos recibir tu auto en el horario solicitado.
#   Opciones disponibles: {{2}}
#   Respondé con el número de la opción que preferís (1, 2 o 3).
# {{1}}=nombre  {{2}}=bloque numerado de fechas/horas
WHATSAPP_TEMPLATE_TURNO_ALTERNATIVAS=turno_alternativas
WHATSAPP_TEMPLATE_LANGUAGE=es_AR
