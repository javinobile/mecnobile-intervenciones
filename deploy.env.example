# Copiá a deploy.env (está en .gitignore) o editá estos defaults en build-and-push.sh.
# Si cambiás de servidor, actualizá solo este archivo.

# --- SSH al VPS ---
SSH_HOST=149.50.134.219
SSH_PORT=5924
SSH_USER=root
SSH_IDENTITY_FILE=~/.ssh/propflow_actions

# --- Registry Docker (en el mismo host) ---
REGISTRY_URL=149.50.134.219:5000
IMAGE_NAME=taller-app
IMAGE_VERSION=latest

# --- Postgres de producción (dentro del VPS; el deploy entra por túnel SSH) ---
# Contenedor del compose: taller_db
DB_USER=root
DB_PASSWORD=Root.1234
DB_NAME=mecnobile-db
# Puerto local del túnel (no tiene que estar libre en el VPS, solo en tu Mac)
SSH_TUNNEL_LOCAL_PORT=15432

# --- Opcional ---
# SKIP_PROD_MIGRATE=1
# SKIP_BACKUP=1
