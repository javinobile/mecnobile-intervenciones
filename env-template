# Usado por Prisma CLI y por Docker Compose (env_file / ${VARS}).
# Para next dev también podés usar .env.local.
# En el VPS: este mismo archivo `.env` con NEXTAUTH_URL de producción.
# Plantilla: copiá a `.env` o mirá `.env.example`.

# Zona horaria del taller (si falta, el contenedor usa UTC y los turnos salen corridos)
TZ=America/Argentina/Buenos_Aires

POSTGRES_USER=root
POSTGRES_PASSWORD=Root.1234
POSTGRES_DB=mecnobile-db

# Prisma CLI (localhost). Compose sobrescribe el host a `db` dentro del contenedor.
DATABASE_URL="postgresql://root:Root.1234@localhost:5432/mecnobile-db?schema=public"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET=
NEXTAUTH_SECRET=

# --- Meta WhatsApp Cloud API ---
META_APP_ID=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_TURNO_CONFIRMADO=turno_confirmado
WHATSAPP_TEMPLATE_TURNO_ALTERNATIVAS=turno_alternativas
WHATSAPP_TEMPLATE_LANGUAGE=es_AR

# --- Groq (consulta *estado* por WhatsApp; opcional) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- SMTP / Mailgun (historial PDF por email al autorizar solicitud WhatsApp) ---
# Ejemplo Mailgun: SMTP_HOST=smtp.mailgun.org  SMTP_PORT=587  SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Debe usar el dominio verificado en Mailgun, ej: Nóbile <historial@mg.tudominio.com>
SMTP_FROM=
