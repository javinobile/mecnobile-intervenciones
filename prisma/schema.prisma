// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MECHANIC
  VIEWER
}

model User {
  id               String         @id @default(cuid())
  name             String?
  email            String         @unique
  emailVerified    DateTime?
  image            String?
  role             Role           @default(MECHANIC)
  accounts         Account[]
  sessions         Session[]
  interventions    Intervention[] @relation("PerformedBy")
  cancelRequests   Intervention[] @relation("CancelRequestedBy")
  appointments     Appointment[]  @relation("AppointmentCreatedBy")
  historyReviews   CarHistoryRequest[] @relation("HistoryReviewedBy")
  passwordHash     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

//Esquema referente al taller
model Client {
  id               String         @id @default(uuid())
  firstName        String
  lastName         String
  phone            String?
  email            String?        @unique
  dni              String         @unique
  address          String?
  ownedCarsHistory CarOwnership[]
  interventions    Intervention[]
  historyRequests  CarHistoryRequest[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // Sin única por nombre+teléfono: el padrón legacy trae homónimos.
  // La identidad real del cliente es el DNI.
}

model Car {
  id           String  @id @default(uuid())
  licensePlate String  @unique
  vin          String  @unique
  engineNumber String?
  color        String?
  make         String?
  model        String?
  year         Int?
  initialKm    Int
  unlockCodes  Json?

  ownershipHistory CarOwnership[]
  interventions    Intervention[]
  appointments     Appointment[]
  historyRequests  CarHistoryRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CarOwnership {
  id        String    @id @default(uuid())
  carId     String
  clientId  String
  startDate DateTime
  endDate   DateTime?

  car    Car    @relation(fields: [carId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([carId])
  @@index([clientId])
}

enum InterventionStatus {
  CERRADA
  ABIERTA
  CANCELADA
}

enum InterventionItemType {
  REPUESTO
  MANO_DE_OBRA
  TRABAJO_TERCERO
}

model Intervention {
  id String @id @default(uuid())

  otNumber    Int
  description String
  notes       String?
  cost        Decimal @default(0.00) @db.Decimal(10, 2)

  status             InterventionStatus @default(ABIERTA)
  dateOfIntervention DateTime           @default(now())

  /// Fecha/hora probable de entrega (opcional; solo informativa para el cliente vía WhatsApp)
  estimatedReadyAt DateTime?

  carId String
  car   Car    @relation(fields: [carId], references: [id], onDelete: Restrict)

  // Snapshot del dueño asociado a esta OT (no cambia si luego se transfiere el auto)
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  performedById String
  performedBy   User   @relation("PerformedBy", fields: [performedById], references: [id], onDelete: Restrict)

  // Solicitud de cancelación (el estado sigue ABIERTA hasta que el ADMIN confirme)
  cancelRequestedAt   DateTime?
  cancelRequestedById String?
  cancelRequestedBy   User?     @relation("CancelRequestedBy", fields: [cancelRequestedById], references: [id], onDelete: SetNull)

  mileageKm Int

  items InterventionItem[]

  /// Turno confirmado del que nació esta OT (si se abrió desde la agenda)
  appointment Appointment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([carId])
  @@index([clientId])
  @@index([performedById])
  @@index([cancelRequestedById])
  @@index([dateOfIntervention])
}

enum AppointmentStatus {
  PENDIENTE
  PROPUESTA_ENVIADA
  CONFIRMADO
}

enum AppointmentSource {
  MANUAL
  WHATSAPP
}

model Appointment {
  id           String             @id @default(uuid())
  startsAt     DateTime
  endsAt       DateTime?
  clientName   String
  clientPhone  String?
  /// Avería / motivo del turno (WhatsApp lo guarda acá)
  notes        String?
  /// Dominio informado (con o sin auto existente en el sistema)
  licensePlate String?
  carId        String?
  car          Car?               @relation(fields: [carId], references: [id], onDelete: SetNull)
  status       AppointmentStatus  @default(PENDIENTE)
  source       AppointmentSource  @default(MANUAL)
  whatsappWaId String?
  /// ISO datetime strings offered by staff when status is PROPUESTA_ENVIADA
  proposedSlots Json?
  /// OT abierta a partir de este turno (solo turnos CONFIRMADO)
  interventionId String?       @unique
  intervention   Intervention? @relation(fields: [interventionId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User               @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([startsAt])
  @@index([status, createdAt])
  @@index([status, startsAt])
  @@index([createdById])
  @@index([whatsappWaId])
  @@index([carId])
  @@index([licensePlate])
}

/// Conversación FSM del bot de WhatsApp (alta de turnos)
model WhatsAppConversation {
  id            String    @id @default(uuid())
  waId          String    @unique
  step          String    @default("IDLE")
  draftName     String?
  draftIssue    String?
  draftPlate    String?
  draftCarId    String?
  draftStartsAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum CarHistoryRequestStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
  ENVIADA
}

/// Solicitud de historial del vehículo por WhatsApp (PDF por email, solo ADMIN aprueba)
model CarHistoryRequest {
  id           String                  @id @default(uuid())
  carId        String
  car          Car                     @relation(fields: [carId], references: [id], onDelete: Cascade)
  clientId     String?
  client       Client?                 @relation(fields: [clientId], references: [id], onDelete: SetNull)
  whatsappWaId String
  email        String
  status       CarHistoryRequestStatus @default(PENDIENTE)
  reviewedById String?
  reviewedBy   User?                   @relation("HistoryReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  sentAt       DateTime?
  rejectReason String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([status, createdAt])
  @@index([carId])
  @@index([whatsappWaId])
}

model InterventionItem {
  id             String               @id @default(uuid())
  interventionId String
  intervention   Intervention         @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  type           InterventionItemType
  description    String
  hours          Decimal?             @db.Decimal(8, 2)
  unitPrice      Decimal              @db.Decimal(10, 2)
  amount         Decimal              @db.Decimal(10, 2)
  sortOrder      Int                  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([interventionId])
}

/// Singleton de configuración del taller (id fijo "default")
model WorkshopSettings {
  id         String   @id @default("default")
  hourlyRate Decimal  @default(0.00) @db.Decimal(10, 2)

  /// Días y horarios de atención: solo se aceptan turnos dentro de estos rangos.
  /// Horas en formato HH:mm (hora local del taller).
  worksSaturday       Boolean @default(false)
  worksSunday         Boolean @default(false)
  openingTime         String  @default("08:00")
  closingTime         String  @default("18:00")
  saturdayOpeningTime String  @default("08:00")
  saturdayClosingTime String  @default("13:00")

  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}
